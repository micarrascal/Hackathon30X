# Clave de API de Anthropic (https://console.anthropic.com/) usada por el chatbot conversacional
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modelo de Claude a usar en la capa conversacional del chatbot
# claude-opus-4-8 (recomendado) | claude-sonnet-5 (mas barato/rapido, buena opcion para demo)
ANTHROPIC_MODEL=claude-opus-4-8

# Conexion a Postgres para Prisma. En Vercel, conectar el storage "Postgres" al
# proyecto inyecta estas mismas variables automaticamente (Storage -> Create Database
# -> Postgres -> Connect). Localmente, usa `vercel env pull .env` o pega la connection
# string de tu propio Postgres (Neon, Vercel Postgres, etc).
POSTGRES_PRISMA_URL="postgresql://user:password@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db"

# Token de EnsembleData (https://ensembledata.com) usado por el enriquecimiento
# de redes sociales en el portal de colaboradores (Instagram + TikTok)
ENSEMBLEDATA_API_TOKEN=your-ensembledata-token

# API key de SocialCrawl (https://www.socialcrawl.dev) usada para obtener el
# perfil detallado (bio, verificado, seguidores, engagement) del username que
# EnsembleData encontro por nombre
SOCIALCRAWL_API_KEY=your-socialcrawl-api-key
