# Clave de API de Anthropic (https://console.anthropic.com/) usada por el chatbot conversacional
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modelo de Claude a usar en la capa conversacional del chatbot
# claude-opus-4-8 (recomendado) | claude-sonnet-5 (mas barato/rapido, buena opcion para demo)
ANTHROPIC_MODEL=claude-opus-4-8

# Conexion SQLite para Prisma (no requiere infraestructura externa)
DATABASE_URL="file:./prisma/dev.db"

# Token de EnsembleData (https://ensembledata.com) usado por el enriquecimiento
# de redes sociales en el portal de colaboradores (Instagram + TikTok)
ENSEMBLEDATA_API_TOKEN=your-ensembledata-token
