// Prisma schema — Postgres (pensado para Vercel Postgres, tambien sirve con Neon u
// otro Postgres). Las variables POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING son
// las que Vercel inyecta automaticamente al conectar el storage "Postgres" al
// proyecto — ver README para el flujo completo de deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(uuid())
  cookieId      String    @unique
  isIdentified  Boolean   @default(false)
  email         String?
  phone         String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  consentGiven  Boolean   @default(false)
  consentDate   DateTime?

  // Seguimiento manual del asesor sobre el lead (independiente del intent score
  // automatico): que un asesor haya marcado que ya contacto a esta persona.
  contactadoPorAsesor Boolean   @default(false)
  contactadoAt        DateTime?

  sessions      Session[]
  events        Event[]
  intentScore   IntentScore?
  employee      Employee?

  @@index([lastSeenAt])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  deviceType  String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPage String

  user   User    @relation(fields: [userId], references: [id])
  events Event[]

  @@index([userId])
}

model Event {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String
  eventType      String   // page_view | search | click | simulator_use | form_start | form_abandon | chatbot_simulacion
  pageUrl        String?
  searchTerm     String?
  elementClicked String?
  metadata       String?  // JSON serializado como string (SQLite no tiene tipo JSON nativo)
  occurredAt     DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([occurredAt])
}

model ScoringRule {
  id          String  @id @default(uuid())
  eventType   String
  pagePattern String?
  points      Int
  description String
}

model IntentScore {
  userId         String   @id
  currentScore   Int      @default(0)
  scoreUpdatedAt DateTime @default(now())
  leadStatus     String   @default("frio") // frio | tibio | caliente

  user User @relation(fields: [userId], references: [id])
}

// Empleados de empresas afiliadas a Colsubsidio — datos 100% sinteticos (ver README).
// linkedUserId conecta, cuando aplica, con el visitante anonimo (User) que resulto ser
// ese mismo empleado navegando colsubsidio.com/creditos.
model Employee {
  id           String   @id @default(uuid())
  cedula       String   @unique
  nombre       String
  empresa      String
  antiguedad   Int // anios en la empresa afiliada
  rol          String
  salario      Int
  correo       String
  edad         Int
  hijos        Int
  genero       String // F | M | X
  createdAt    DateTime @default(now())

  // Campos usados por el motor de probabilidad (api/probabilidad.py) para
  // aproximar los requisitos reales de credito.md (ver UI_UX System for Woop).
  categoriaAfiliacion    String  @default("B") // A | B | C
  tipoVinculacion        String  @default("asalariado") // asalariado | pensionado | independiente
  libranza               Boolean @default(false)
  tieneCreditoVivienda   Boolean @default(false) // habilita "mejora de vivienda"
  tieneTarjetaColsubsidio Boolean @default(true) // habilita "cupo rotativo"

  linkedUserId String?  @unique
  linkedUser   User?    @relation(fields: [linkedUserId], references: [id])

  // Seguimiento de la oferta por correo que un asesor le mando desde el
  // recomendador de producto (ver ProspectoActionsPanel / vista de oferta).
  ofertaEnviadaAt      DateTime?
  ofertaEnviadaProducto String?

  enrichments  EmployeeEnrichment[]
  productScore CreditProductScore?
  woopRegistro WoopRegistro?

  @@index([cedula])
}

// Pre-simulacion que el colaborador dejo por su cuenta en la app Woop (sin pasar
// por colsubsidio.com/creditos ni hablar con un asesor). Es la "necesidad declarada"
// contra la que se compara la prediccion del motor de probabilidad (ver "acierto"
// en api/probabilidad.py) cuando el asesor vuelve a correr la simulacion.
model WoopRegistro {
  employeeId      String   @id
  montoSolicitado Int
  plazoMeses      Int
  productoInteres String // una de las 8 claves de producto (ver CreditProductScore)
  motivo          String? // texto libre que dejo el colaborador ("remodelar la cocina", etc.)
  registradoAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

// Resultado (cacheado) de buscar el nombre del empleado en redes sociales via EnsembleData.
// Es una coincidencia por nombre, no una identidad verificada — ver disclaimer en la UI.
model EmployeeEnrichment {
  id              String   @id @default(uuid())
  employeeId      String
  provider        String // instagram | tiktok
  source          String   @default("ensembledata") // ensembledata | ensembledata+socialcrawl
  query           String // nombre usado para buscar
  matchedUsername String?
  matchedFullName String?
  bio             String?
  followers       Int?
  verified        Boolean?
  engagementRate  Float?
  profileUrl      String?
  raw             String? // JSON crudo de la(s) respuesta(s)
  fetchedAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Probabilidad estimada (0-100, determinista, calculada por api/probabilidad.py en Python,
// sin LLM) de interes por cada una de las 8 lineas reales de credito de Colsubsidio
// (ver UI_UX System for Woop (1)/src/imports/credito.md).
model CreditProductScore {
  employeeId    String   @id
  libreInversion Float
  hipotecario    Float
  mejoraVivienda Float
  educativo      Float
  mujeres        Float
  compraCartera  Float
  mipymes        Float
  cupoRotativo   Float
  topProduct     String
  computedAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}
