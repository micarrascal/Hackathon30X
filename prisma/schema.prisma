// Prisma schema — SQLite para demo de hackathon (cero infraestructura externa)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  cookieId      String    @unique
  isIdentified  Boolean   @default(false)
  email         String?
  phone         String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  consentGiven  Boolean   @default(false)
  consentDate   DateTime?

  sessions      Session[]
  events        Event[]
  intentScore   IntentScore?
  employee      Employee?

  @@index([lastSeenAt])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  deviceType  String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPage String

  user   User    @relation(fields: [userId], references: [id])
  events Event[]

  @@index([userId])
}

model Event {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String
  eventType      String   // page_view | search | click | simulator_use | form_start | form_abandon | chatbot_simulacion
  pageUrl        String?
  searchTerm     String?
  elementClicked String?
  metadata       String?  // JSON serializado como string (SQLite no tiene tipo JSON nativo)
  occurredAt     DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([occurredAt])
}

model ScoringRule {
  id          String  @id @default(uuid())
  eventType   String
  pagePattern String?
  points      Int
  description String
}

model IntentScore {
  userId         String   @id
  currentScore   Int      @default(0)
  scoreUpdatedAt DateTime @default(now())
  leadStatus     String   @default("frio") // frio | tibio | caliente

  user User @relation(fields: [userId], references: [id])
}

// Empleados de empresas afiliadas a Colsubsidio — datos 100% sinteticos (ver README).
// linkedUserId conecta, cuando aplica, con el visitante anonimo (User) que resulto ser
// ese mismo empleado navegando colsubsidio.com/creditos.
model Employee {
  id           String   @id @default(uuid())
  cedula       String   @unique
  nombre       String
  empresa      String
  antiguedad   Int // anios en la empresa afiliada
  rol          String
  salario      Int
  correo       String
  edad         Int
  hijos        Int
  genero       String // F | M | X
  createdAt    DateTime @default(now())

  linkedUserId String?  @unique
  linkedUser   User?    @relation(fields: [linkedUserId], references: [id])

  enrichments  EmployeeEnrichment[]
  productScore CreditProductScore?

  @@index([cedula])
}

// Resultado (cacheado) de buscar el nombre del empleado en redes sociales via EnsembleData.
// Es una coincidencia por nombre, no una identidad verificada — ver disclaimer en la UI.
model EmployeeEnrichment {
  id              String   @id @default(uuid())
  employeeId      String
  provider        String // instagram | tiktok
  query           String // nombre usado para buscar
  matchedUsername String?
  matchedFullName String?
  bio             String?
  followers       Int?
  profileUrl      String?
  raw             String? // JSON crudo de la respuesta de EnsembleData
  fetchedAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Probabilidad estimada (0-100, determinista, sin LLM) de interes por cada producto de credito.
model CreditProductScore {
  employeeId  String   @id
  cupoCredito Float
  consumo     Float
  vivienda    Float
  mujeres     Float
  educativo   Float
  topProduct  String
  computedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}
